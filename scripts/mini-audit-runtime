#!/usr/bin/env python3
"""Launcher for `mini-audit-runtime`.

Usage:

    mini-audit-runtime state init --repo-root /path/to/repo [--mode balanced]
    mini-audit-runtime phase start L5
    mini-audit-runtime gate L7
    mini-audit-runtime export --format sarif

The launcher resolves the runtime package via three strategies in order:

1. `MINI_AUDIT_RUNTIME_HOME` env var (override).
2. `$MAVIS_SKILLS_DIR/mini-audit/runtime` if MiniMax Code is available.
3. Relative to this script (`../runtime/`).

All paths in the runtime are computed relative to `--audit-root` (default
`mini-audit/`).
"""
from __future__ import annotations

import os
import sys
from pathlib import Path


def _resolve_runtime_root() -> Path:
    """Return the parent directory of the ``runtime`` package.

    Adding the package directory itself to ``sys.path`` only makes it
    importable as a flat namespace (``import runtime`` finds ``runtime.py``,
    not the package). We need the parent so that ``from runtime import cli``
    resolves to ``<root>/runtime/cli.py``.
    """
    override = os.environ.get("MINI_AUDIT_RUNTIME_HOME")
    if override:
        candidate = Path(override).resolve()
        # Allow either the package dir or its parent.
        if (candidate / "__init__.py").exists():
            return candidate.parent
        return candidate

    mavis_root = os.environ.get("MAVIS_SKILLS_DIR")
    if mavis_root:
        candidate = Path(mavis_root) / "mini-audit"
        if (candidate / "runtime" / "__init__.py").exists():
            return candidate.resolve()

    here = Path(__file__).resolve().parent
    candidate = here.parent
    if (candidate / "runtime" / "__init__.py").exists():
        return candidate.resolve()

    return Path.cwd().resolve()


def main() -> int:
    runtime_root = _resolve_runtime_root()
    if str(runtime_root) not in sys.path:
        sys.path.insert(0, str(runtime_root))
    try:
        from runtime import cli  # type: ignore[import-not-found]
    except ImportError as exc:  # pragma: no cover - installer error path
        sys.stderr.write(f"mini-audit-runtime: cannot import runtime.cli: {exc}\n")
        sys.stderr.write(f"  resolved runtime root: {runtime_root}\n")
        return 3
    return cli.main()


if __name__ == "__main__":
    raise SystemExit(main())