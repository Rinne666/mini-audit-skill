{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Rinne666/mini-audit-skill/schemas/triage-table.schema.json",
  "title": "Disclosure Triage and Coverage Ledgers",
  "description": "Structural requirements for the three-question coverage of every confirmed finding, premise citations, work-queue closure, and send-order discipline. Passing this schema does not prove the maintainer will accept the report or that the conclusions are correct.",
  "type": "object",
  "required": ["rows", "coverage_paragraph_present", "question_coverage", "work_queue", "premise_checks", "send_order", "channel"],
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "description": "One triage decision per confirmed finding: its disposition, the three question-answers that produced it, and the subject it will be reported under.",
      "items": {
        "type": "object",
        "required": ["fingerprint", "title", "disposition", "premise_kind", "boundary_state", "divergence_state", "subject", "rationale", "evidence_ids"],
        "properties": {
          "fingerprint": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "disposition": {
            "enum": ["send", "rewrite_then_send", "convert_to_hardening"],
            "description": "send = report as a vulnerability now. rewrite_then_send = restate the subject as the invariant, then report. convert_to_hardening = offer as a patch, not a report."
          },
          "premise_kind": {
            "enum": ["attacker_only", "requires_operator_decision", "requires_ambient_state", "requires_third_party_misconfiguration"]
          },
          "boundary_state": {
            "enum": ["declared_and_violated", "not_declared", "declared_and_consistent"]
          },
          "divergence_state": {
            "enum": ["present", "absent", "not_applicable"]
          },
          "divergence_sides": {
            "type": "array",
            "minItems": 2,
            "description": "Both sides of a same-version behavioural divergence, each with file:line. Required when divergence_state is present.",
            "items": {
              "type": "object",
              "required": ["file_line", "behavior"],
              "properties": {
                "file_line": {"type": "string", "pattern": "^.+:[0-9]+(-[0-9]+)?$"},
                "behavior": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "description": "The invariant the code fails to enforce. A consequence is not a subject."
          },
          "original_subject": {
            "type": "string",
            "description": "The consequence-framed subject this replaced, when a rewrite happened."
          },
          "rationale": {"type": "string", "minLength": 1},
          "hardening_suggestion": {
            "type": "string",
            "description": "Required when disposition is convert_to_hardening: the change to offer instead of a report."
          },
          "closure_driven": {
            "type": "boolean",
            "description": "True when a prior closure by the maintainer changed this disposition."
          },
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{6}$"}}
        },
        "additionalProperties": false
      }
    },
    "question_coverage": {
      "type": "array",
      "minItems": 3,
      "description": "One explicit status per mandatory triage question. Three questions are required for every finding.",
      "items": {
        "type": "object",
        "required": ["question", "status", "strategy", "evidence", "evidence_ids"],
        "properties": {
          "question": {"enum": ["premise", "boundary", "divergence"]},
          "status": {"enum": ["HUNTED", "NEEDS-RUNTIME"]},
          "strategy": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "absence_searches": {
            "type": "array",
            "description": "Two distinct captured zero-match searches, required when a divergence is claimed absent.",
            "items": {
              "type": "object",
              "required": ["evidence_id"],
              "properties": {
                "evidence_id": {"type": "string", "pattern": "^E[0-9]{6}$"}
              },
              "additionalProperties": false
            }
          },
          "reason": {"type": "string"},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{6}$"}}
        },
        "additionalProperties": false
      }
    },
    "work_queue": {
      "type": "array",
      "minItems": 4,
      "description": "One bounded work item per triage question plus a final review. At Deliver, every item must be completed or explicitly deferred; active or queued work blocks the report.",
      "items": {
        "type": "object",
        "required": ["id", "category", "task", "priority", "reason", "budget_unit", "stop_condition", "status", "outcome", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^W[0-9]+$"},
          "category": {"enum": ["premise", "boundary", "divergence", "ordering", "final_review", "other"]},
          "task": {"type": "string", "minLength": 1},
          "priority": {"enum": ["high", "medium", "low"]},
          "reason": {"type": "string", "minLength": 1},
          "budget_unit": {"type": "string", "minLength": 1},
          "stop_condition": {"type": "string", "minLength": 1},
          "status": {"enum": ["queued", "active", "completed", "deferred"]},
          "outcome": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{6}$"}}
        },
        "additionalProperties": false
      }
    },
    "premise_checks": {
      "type": "array",
      "minItems": 1,
      "description": "Every claim a disposition depends on, with the source location that was read and the reviewer's verdict on it.",
      "items": {
        "type": "object",
        "required": ["claim", "location", "expression", "evaluated_result", "verdict", "evidence_ids"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "protected_consumer": {"type": "string", "minLength": 1},
          "location": {"type": "string", "pattern": "^.+:[0-9]+(-[0-9]+)?$"},
          "expression": {
            "type": "string",
            "minLength": 1,
            "description": "The exact condition asserted at that location. 'standard check exists' is not a valid expression."
          },
          "attacker_shape": {"type": "string"},
          "evaluated_result": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["effective", "ineffective", "uncertain", "none_found"]},
          "absence_searches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id"],
              "properties": {
                "evidence_id": {"type": "string", "pattern": "^E[0-9]{6}$"}
              },
              "additionalProperties": false
            }
          },
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{6}$"}}
        },
        "additionalProperties": false
      }
    },
    "send_order": {
      "type": "array",
      "minItems": 1,
      "description": "The order in which reports are sent. The first entry establishes the credibility for the rest, so it is chosen by premise cleanliness, not by severity.",
      "items": {
        "type": "object",
        "required": ["position", "fingerprint", "disposition", "reason"],
        "properties": {
          "position": {"type": "integer", "minimum": 1},
          "fingerprint": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["send", "rewrite_then_send"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "channel": {
      "type": "object",
      "required": ["name", "reason"],
      "description": "Exactly one reporting channel. Two channels mean duplicate intake and read as spam.",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "alternative_considered": {"type": "string"}
      },
      "additionalProperties": false
    },
    "coverage_paragraph_present": {
      "type": "boolean",
      "enum": [true],
      "description": "The notes file contains a Coverage section enumerating what was checked for each triage question."
    }
  },
  "additionalProperties": false
}
