{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rinne666/mini-audit-skill/schemas/search-ledger.schema.json",
  "title": "mini-audit search-ledger",
  "description": "What the search currently knows, suspects, is blocked on, and intends to investigate next (Search Governance v1, R2-1). This is the research plane, not the finding-verdict plane: agents never write this file. They submit a research delta and the runtime applies it under the Search Governance lock. Semantic keys are the idempotency address; identity fields decide conflicts and mutable fields merge.",
  "type": "object",
  "required": ["schema_version", "facts", "assumptions", "open_questions", "blocked_paths", "intents"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "audit_id": {"type": "string"},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/Fact"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/Assumption"}},
    "open_questions": {"type": "array", "items": {"$ref": "#/$defs/OpenQuestion"}},
    "blocked_paths": {"type": "array", "items": {"$ref": "#/$defs/BlockedPath"}},
    "intents": {"type": "array", "items": {"$ref": "#/$defs/Intent"}},
    "updated_at": {"type": "string"}
  },
  "$defs": {
    "RefList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "Fact": {
      "type": "object",
      "required": ["id", "key", "claim"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^FCT-[0-9]{3,}$"},
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Author-supplied idempotency address. Re-applying a delta that carries the same key must not create a second object."
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "description": "Identity field. A different claim is a different fact and needs a new key."
        },
        "evidence_refs": {"$ref": "#/$defs/RefList"},
        "source_refs": {"$ref": "#/$defs/RefList"},
        "confidence": {"enum": ["unknown", "low", "medium", "high"]},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      }
    },
    "Assumption": {
      "type": "object",
      "required": ["id", "key", "claim", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^A-[0-9]{3,}$"},
        "key": {"type": "string", "minLength": 1},
        "claim": {
          "type": "string",
          "minLength": 1,
          "description": "Identity field — the security assumption the product depends on."
        },
        "status": {
          "enum": ["unverified", "supported", "disproved"],
          "description": "supported strengthens every blocker that depends on this claim; disproved reopens them. Mirrored from the fact that an assumption is a first-class object, not a note."
        },
        "evidence_refs": {"$ref": "#/$defs/RefList"},
        "source_refs": {"$ref": "#/$defs/RefList"},
        "depended_on_by": {
          "$ref": "#/$defs/RefList",
          "description": "Informational: recomputed by the runtime from blocked paths whose blocker names this assumption. Not the source of truth for reopen decisions."
        },
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      }
    },
    "OpenQuestion": {
      "type": "object",
      "required": ["id", "key", "question", "priority", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^OQ-[0-9]{3,}$"},
        "key": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1, "description": "Identity field."},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "status": {"enum": ["open", "resolved", "refuted", "deferred"]},
        "reason": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/RefList"},
        "reopen_if": {"$ref": "#/$defs/RefList"},
        "attempt_refs": {
          "$ref": "#/$defs/RefList",
          "description": "Paths to execution records proving the question was actually investigated. A deferral with no attempt behind it is not a deferral."
        },
        "blocked_path_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Alternative to attempt_refs for a deferral that follows from a still-valid blocker, e.g. a BP- id whose assumption is supported."
        },
        "related_candidates": {"$ref": "#/$defs/RefList"},
        "related_capabilities": {"$ref": "#/$defs/RefList"},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "resolved"}}},
          "then": {
            "required": ["reason", "evidence_refs"],
            "properties": {"evidence_refs": {"minItems": 1}}
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "refuted"}}},
          "then": {
            "required": ["reason", "evidence_refs"],
            "properties": {"evidence_refs": {"minItems": 1}}
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "deferred"}}},
          "then": {
            "required": ["reason", "reopen_if"],
            "properties": {"reopen_if": {"minItems": 1}},
            "anyOf": [
              {"required": ["attempt_refs"], "properties": {"attempt_refs": {"minItems": 1}}},
              {"required": ["blocked_path_ref"], "properties": {"blocked_path_ref": {"minLength": 1}}}
            ]
          }
        }
      ]
    },
    "BlockedPath": {
      "type": "object",
      "required": ["id", "key", "candidate_id", "blocker", "status", "priority"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^BP-[0-9]{3,}$"},
        "key": {"type": "string", "minLength": 1},
        "candidate_id": {
          "type": "string",
          "pattern": "^cand-[a-z0-9-]{3,}$",
          "description": "Identity field. Candidates keep their own author-supplied ids; this is the only pointer between the two id spaces."
        },
        "blocker": {
          "type": "object",
          "required": ["type", "claim"],
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "minLength": 1, "description": "Identity field."},
            "claim": {"type": "string", "minLength": 1, "description": "Identity field. The same candidate can legitimately carry two blockers of the same type, so type alone is not enough."},
            "assumption_ref": {
              "type": "string",
              "minLength": 1,
              "description": "Identity field when present. An assumption id (A-…) or semantic key that, if disproved, invalidates this blocker."
            }
          }
        },
        "status": {
          "enum": ["blocked", "reopened", "closed"],
          "description": "A locally real bug that cannot be exploited yet stays 'blocked'. It is never moved to the candidate's rejected status: 'this path is currently obstructed' is not 'this bug is disproved'."
        },
        "evidence_refs": {"$ref": "#/$defs/RefList"},
        "priority": {"enum": ["low", "medium", "high"]},
        "reopen_if": {"$ref": "#/$defs/RefList"},
        "attempt_refs": {"$ref": "#/$defs/RefList"},
        "close_reason": {
          "type": "string",
          "minLength": 1,
          "description": "Written by the runtime when a path closes, e.g. 'blocker_supported'. Closing a path never rewrites the candidate's own status."
        },
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      }
    },
    "Intent": {
      "type": "object",
      "required": ["id", "key", "question_ref", "strategy", "priority", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^INT-[0-9]{3,}$"},
        "key": {"type": "string", "minLength": 1},
        "question_ref": {"type": "string", "minLength": 1, "description": "Identity field."},
        "strategy": {"type": "string", "minLength": 1, "description": "Identity field — e.g. caller-search, variant-search, capability-consumer-search."},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "status": {"enum": ["proposed", "assigned", "done", "dropped"]},
        "reason": {"type": "string"},
        "assigned_agent": {"type": "string"},
        "attempt_refs": {"$ref": "#/$defs/RefList"},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      }
    }
  }
}
