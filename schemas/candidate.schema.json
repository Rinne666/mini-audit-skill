{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rinne666/mini-audit-skill/schemas/candidate.schema.json",
  "title": "mini-audit candidate",
  "description": "Candidate record produced by Review Chamber or scanner normalization (Spec §13, §28). Never a confirmed finding.",
  "type": "object",
  "required": ["candidate_id", "source", "status"],
  "additionalProperties": true,
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^cand-[a-z0-9-]{3,}$"},
    "source": {"type": "string", "description": "Provenance: 'semgrep', 'codeql', 'gitleaks', 'review-chamber', ...", "minLength": 1},
    "rule_id": {"type": "string"},
    "file": {"type": "string"},
    "line": {"type": "integer", "minimum": 0},
    "message": {"type": "string"},
    "class": {"type": "string"},
    "confidence": {"enum": ["unknown", "low", "medium", "high"]},
    "status": {"enum": ["untriaged", "promoted", "rejected", "needs_validation"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "claim": {"type": "string"},
    "attacker": {"type": "string"},
    "boundary_hypothesis": {"type": "string"},
    "trace_hypothesis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "symbol": {"type": "string"}
        }
      }
    },
    "debate_status": {"enum": ["open", "closed"]},
    "promotion_recommendation": {"enum": ["PROMOTE_FOR_VERIFICATION", "REJECT", "DEFER"]},
    "research": {"$ref": "#/$defs/CandidateResearch"}
  },
  "$defs": {
    "CandidateResearch": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Research value of a candidate — a different axis from its security verdict (Search Governance v1, R2-2). Optional here because a scanner-normalized 'untriaged' candidate should not be forced to carry research metadata and existing fixtures must stay valid; the L6 Review Chamber enforces it semantically for candidates the chamber accepts.",
      "properties": {
        "local_validity": {"enum": ["unknown", "verified", "refuted"]},
        "role": {"enum": ["standalone", "chain_seed", "prerequisite", "unknown"]},
        "chain_potential": {"enum": ["low", "medium", "high"]},
        "requires_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "grants_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "depends_on_assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "breaks_assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "blocked_by": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reopen_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}