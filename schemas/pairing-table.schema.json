{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Rinne666/mini-audit-skill/schemas/pairing-table.schema.json",
  "title": "Audit Coverage, Pairing, and Review Ledgers",
  "description": "Structural requirements for source-derived coverage units, independent coverage reviews, candidate dispositions, run status, evidence, and trust pairings. Passing does not prove semantic completeness.",
  "type": "object",
  "required": ["rows", "coverage_paragraph_present", "class_coverage", "business_logic_review", "coverage_units", "coverage_reviews", "candidate_reviews", "run_status", "budget", "incomplete_reasons", "guard_checks"],
  "properties": {
    "rows": {
      "type": "array",
      "description": "Evidence-backed trust-source to trust-consumer relationships discovered during the audit.",
      "items": {
        "type": "object",
        "required": ["category", "trust_source", "trust_consumer", "attacker_reach", "status", "file_line", "rationale", "evidence_ids"],
        "properties": {
          "category": {"enum": ["authz_sensitive_write", "identity_to_decision", "callback_to_sink", "state_cross_endpoint", "other"]},
          "trust_source": {"type": "string", "minLength": 1},
          "trust_consumer": {"type": "string", "minLength": 1},
          "attacker_reach": {"type": "string", "minLength": 1},
          "status": {"enum": ["upgraded", "DISPROVED", "NEEDS-RUNTIME"]},
          "file_line": {"type": "string", "pattern": "^.+:[0-9]+(-[0-9]+)?$"},
          "rationale": {"type": "string", "minLength": 1},
          "disproof_evidence": {"type": "string", "minLength": 1},
          "evidence_ids": {"$ref": "#/definitions/evidenceIds"}
        },
        "additionalProperties": false
      }
    },
    "class_coverage": {
      "type": "array",
      "minItems": 4,
      "description": "One explicit roll-up status for each mandatory baseline security lens.",
      "items": {
        "type": "object",
        "required": ["category", "status", "strategy", "evidence", "evidence_ids"],
        "properties": {
          "category": {"enum": ["authz_sensitive_write", "identity_to_decision", "callback_to_sink", "state_cross_endpoint"]},
          "status": {"enum": ["NOT_CHECKED", "IN_PROGRESS", "HUNTED", "N/A", "NEEDS-RUNTIME"]},
          "strategy": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "absence_searches": {"$ref": "#/definitions/absenceSearches"},
          "reason": {"type": "string"},
          "evidence_ids": {"$ref": "#/definitions/evidenceIds"}
        },
        "additionalProperties": false
      }
    },
    "business_logic_review": {
      "type": "object",
      "description": "Source-backed inventory and coverage links for security-relevant business workflows, or an evidenced N/A decision.",
      "required": ["status", "strategy", "workflows", "evidence_ids"],
      "properties": {
        "status": {"enum": ["NOT_CHECKED", "IN_PROGRESS", "REVIEWED", "N/A"]},
        "strategy": {"type": "string", "minLength": 1},
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["workflow_id", "name", "source_refs", "actors", "protected_assets", "invariants", "transitions_reviewed", "failure_retry_cases", "abuse_cases_checked", "coverage_ids", "evidence_ids"],
            "properties": {
              "workflow_id": {"type": "string", "pattern": "^BF[0-9]+$"},
              "name": {"type": "string", "minLength": 1},
              "source_refs": {"$ref": "#/definitions/nonEmptyStringList"},
              "actors": {"$ref": "#/definitions/nonEmptyStringList"},
              "protected_assets": {"$ref": "#/definitions/nonEmptyStringList"},
              "invariants": {"$ref": "#/definitions/nonEmptyStringList"},
              "transitions_reviewed": {"$ref": "#/definitions/nonEmptyStringList"},
              "failure_retry_cases": {"$ref": "#/definitions/nonEmptyStringList"},
              "abuse_cases_checked": {"$ref": "#/definitions/nonEmptyStringList"},
              "coverage_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CU-[0-9a-f]{24}$"}},
              "evidence_ids": {"$ref": "#/definitions/evidenceIds"}
            },
            "additionalProperties": false
          }
        },
        "evidence_ids": {"$ref": "#/definitions/evidenceIds"},
        "absence_searches": {"$ref": "#/definitions/absenceSearches"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "coverage_units": {
      "type": "array",
      "minItems": 4,
      "description": "Single source of truth for planned and completed surface-by-boundary-by-subsystem-by-class review work.",
      "items": {
        "type": "object",
        "required": ["coverage_id", "dimensions", "baseline_category", "source_refs", "entry_points", "paths_in_scope", "task", "priority", "budget_unit", "stop_condition", "wave", "owner_id", "status", "outcome", "evidence_ids", "candidate_ids"],
        "properties": {
          "coverage_id": {"type": "string", "pattern": "^CU-[0-9a-f]{24}$"},
          "dimensions": {
            "type": "object",
            "required": ["surface", "boundary", "subsystem", "attack_class"],
            "properties": {
              "surface": {"type": "string", "minLength": 1},
              "boundary": {"type": "string", "minLength": 1},
              "subsystem": {"type": "string", "minLength": 1},
              "attack_class": {"type": "string", "minLength": 1},
              "lifecycle": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "baseline_category": {"type": ["string", "null"], "enum": ["authz_sensitive_write", "identity_to_decision", "callback_to_sink", "state_cross_endpoint", null]},
          "source_refs": {"$ref": "#/definitions/nonEmptyStringList"},
          "entry_points": {"$ref": "#/definitions/nonEmptyStringList"},
          "paths_in_scope": {"$ref": "#/definitions/nonEmptyStringList"},
          "task": {"type": "string", "minLength": 1},
          "priority": {"enum": ["high", "medium", "low"]},
          "budget_unit": {"type": "string", "minLength": 1},
          "stop_condition": {"type": "string", "minLength": 1},
          "wave": {"type": "integer", "minimum": 1},
          "owner_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "in_progress", "covered", "candidate", "blocked", "deferred", "not_applicable", "out_of_scope"]},
          "outcome": {"type": "string", "minLength": 1},
          "limitation": {"type": "string"},
          "absence_searches": {"$ref": "#/definitions/absenceSearches"},
          "evidence_ids": {"$ref": "#/definitions/evidenceIds"},
          "candidate_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]+$"}}
        },
        "additionalProperties": false
      }
    },
    "coverage_reviews": {
      "type": "array",
      "description": "Independent post-wave gap critics plus a cold-start final coverage review.",
      "items": {
        "type": "object",
        "required": ["review_id", "review_type", "wave", "reviewer_id", "independent", "scope_reviewed", "reviewed_coverage_ids", "decision", "new_coverage_ids", "evidence_ids"],
        "properties": {
          "review_id": {"type": "string", "pattern": "^CR[0-9]+$"},
          "review_type": {"enum": ["post_wave", "final_clean"]},
          "wave": {"type": ["integer", "null"], "minimum": 1},
          "reviewer_id": {"type": "string", "minLength": 1},
          "independent": {"type": "boolean"},
          "scope_reviewed": {"type": "string", "minLength": 1},
          "reviewed_coverage_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CU-[0-9a-f]{24}$"}},
          "decision": {"enum": ["clean", "gaps_found"]},
          "new_coverage_ids": {"type": "array", "items": {"type": "string", "pattern": "^CU-[0-9a-f]{24}$"}},
          "evidence_ids": {"$ref": "#/definitions/evidenceIds"}
        },
        "additionalProperties": false
      }
    },
    "candidate_reviews": {
      "type": "array",
      "description": "Independent dispositions for every candidate linked from a coverage unit.",
      "items": {
        "type": "object",
        "required": ["candidate_id", "claim", "source_refs", "verdict", "verifier_id", "independent", "reviewed_paths", "disproof_attempt", "unresolved", "evidence_ids"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^C[0-9]+$"},
          "claim": {"type": "string", "minLength": 1},
          "source_refs": {"$ref": "#/definitions/nonEmptyStringList"},
          "verdict": {"enum": ["confirmed", "needs_validation", "rejected"]},
          "verifier_id": {"type": "string", "minLength": 1},
          "independent": {"type": "boolean"},
          "reviewed_paths": {"$ref": "#/definitions/nonEmptyStringList"},
          "disproof_attempt": {"type": "string", "minLength": 1},
          "unresolved": {"type": "string"},
          "evidence_ids": {"$ref": "#/definitions/evidenceIds"}
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "required": ["unit", "max_units", "spent_units", "review_reserve_units", "candidate_review_reserve_units"],
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "max_units": {"type": "integer", "minimum": 1},
        "spent_units": {"type": "integer", "minimum": 0},
        "review_reserve_units": {"type": "integer", "minimum": 1},
        "candidate_review_reserve_units": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "run_status": {"enum": ["complete", "incomplete"]},
    "incomplete_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "guard_checks": {
      "type": "array",
      "minItems": 1,
      "description": "Semantic evaluation records for guards near dangerous sinks or security decisions.",
      "items": {
        "type": "object",
        "required": ["protected_consumer", "guard_location", "expression", "attacker_input_shape", "evaluated_result", "verdict", "evidence_ids"],
        "properties": {
          "protected_consumer": {"type": "string", "minLength": 1},
          "guard_location": {"type": "string", "minLength": 1},
          "expression": {"type": "string", "minLength": 1},
          "attacker_input_shape": {"type": "string", "minLength": 1},
          "evaluated_result": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["effective", "ineffective", "uncertain", "none_found"]},
          "absence_searches": {"$ref": "#/definitions/absenceSearches"},
          "evidence_ids": {"$ref": "#/definitions/evidenceIds"}
        },
        "additionalProperties": false
      }
    },
    "coverage_paragraph_present": {"type": "boolean", "enum": [true], "description": "The notes file contains a Coverage section enumerating protocol entries reaching each dangerous primitive."}
  },
  "definitions": {
    "evidenceIds": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{6}$"}},
    "nonEmptyStringList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "absenceSearches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id"],
        "properties": {"evidence_id": {"type": "string", "pattern": "^E[0-9]{6}$"}},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
