{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Rinne666/mini-audit-skill/schemas/pairing-table.schema.json",
  "title": "Synthesize Pairing and Coverage Ledgers",
  "description": "Structural requirements for mandatory trust-pairing categories, class coverage, work-queue closure, and guard evaluation. Passing this schema does not prove that the audit searched completely or that its conclusions are correct.",
  "type": "object",
  "required": ["rows", "coverage_paragraph_present", "class_coverage", "work_queue", "guard_checks"],
  "properties": {
    "rows": {
      "type": "array",
      "description": "Evidence-backed trust-source to trust-consumer relationships discovered during the audit.",
      "items": {
        "type": "object",
        "required": ["category", "trust_source", "trust_consumer", "attacker_reach", "status", "file_line", "rationale", "evidence_ids"],
        "properties": {
          "category": {
            "enum": ["authz_sensitive_write", "identity_to_decision", "callback_to_sink", "state_cross_endpoint", "other"]
          },
          "trust_source": {"type": "string", "minLength": 1},
          "trust_consumer": {"type": "string", "minLength": 1},
          "attacker_reach": {"type": "string", "minLength": 1},
          "status": {"enum": ["upgraded", "DISPROVED", "NEEDS-RUNTIME"]},
          "file_line": {"type": "string", "pattern": "^.+:[0-9]+(-[0-9]+)?$"},
          "rationale": {"type": "string", "minLength": 1},
          "disproof_evidence": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{6}$"}}
        },
        "additionalProperties": false
      }
    },
    "class_coverage": {
      "type": "array",
      "minItems": 4,
      "description": "One explicit status for each baseline security lens, whether hunted or justified as not applicable.",
      "items": {
        "type": "object",
        "required": ["category", "status", "strategy", "evidence", "evidence_ids"],
        "properties": {
          "category": {"enum": ["authz_sensitive_write", "identity_to_decision", "callback_to_sink", "state_cross_endpoint"]},
          "status": {"enum": ["NOT_CHECKED", "IN_PROGRESS", "HUNTED", "N/A", "NEEDS-RUNTIME"]},
          "strategy": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "absence_searches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id"],
              "properties": {
                "evidence_id": {"type": "string", "pattern": "^E[0-9]{6}$"}
              },
              "additionalProperties": false
            }
          },
          "reason": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{6}$"}}
        },
        "additionalProperties": false
      }
    },
    "work_queue": {
      "type": "array",
      "minItems": 4,
      "description": "One bounded work item per baseline category plus a final review. At Report, every item must be completed or explicitly deferred; active or queued work blocks the report.",
      "items": {
        "type": "object",
        "required": ["id", "category", "task", "priority", "reason", "budget_unit", "stop_condition", "status", "outcome", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^W[0-9]+$"},
          "category": {"enum": ["authz_sensitive_write", "identity_to_decision", "callback_to_sink", "state_cross_endpoint", "final_review", "other"]},
          "task": {"type": "string", "minLength": 1},
          "priority": {"enum": ["high", "medium", "low"]},
          "reason": {"type": "string", "minLength": 1},
          "budget_unit": {"type": "string", "minLength": 1},
          "stop_condition": {"type": "string", "minLength": 1},
          "status": {"enum": ["queued", "active", "completed", "deferred"]},
          "outcome": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{6}$"}}
        },
        "additionalProperties": false
      }
    },
    "guard_checks": {
      "type": "array",
      "minItems": 1,
      "description": "Semantic evaluation records for guards near dangerous sinks or security decisions.",
      "items": {
        "type": "object",
        "required": ["protected_consumer", "guard_location", "expression", "attacker_input_shape", "evaluated_result", "verdict", "evidence_ids"],
        "properties": {
          "protected_consumer": {"type": "string", "minLength": 1},
          "guard_location": {"type": "string", "minLength": 1},
          "expression": {"type": "string", "minLength": 1},
          "attacker_input_shape": {"type": "string", "minLength": 1},
          "evaluated_result": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["effective", "ineffective", "uncertain", "none_found"]},
          "absence_searches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id"],
              "properties": {
                "evidence_id": {"type": "string", "pattern": "^E[0-9]{6}$"}
              },
              "additionalProperties": false
            }
          },
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]{6}$"}}
        },
        "additionalProperties": false
      }
    },
    "coverage_paragraph_present": {
      "type": "boolean",
      "enum": [true],
      "description": "The notes file contains a Coverage section enumerating protocol entries reaching each dangerous primitive."
    }
  },
  "additionalProperties": false
}
