{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rinne666/mini-audit-skill/schemas/attack-graph.schema.json",
  "title": "mini-audit attack-graph",
  "description": "What the attacker currently holds and how those capabilities convert into one another (Search Governance v1, R2-6). Node types are limited to principal, capability and goal: a node type the runtime cannot verify would reintroduce the 'declared but unchecked' failure mode v1.1.1 removed. The principal and goal nodes are seeded from the canonical objective, so 'distance to target' has a defined origin.",
  "type": "object",
  "required": ["schema_version", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "audit_id": {"type": "string"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/Node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/Edge"}},
    "updated_at": {"type": "string"}
  },
  "$defs": {
    "RefList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "Node": {
      "type": "object",
      "required": ["id", "key", "type", "name", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(PRIN|CAP|GOAL)-[0-9]{3,}$"},
        "key": {"type": "string", "minLength": 1},
        "type": {"enum": ["principal", "capability", "goal"]},
        "name": {"type": "string", "minLength": 1},
        "principal": {
          "type": "string",
          "description": "Which principal holds this capability. Capability identity is (name, principal), so the same name under two principals is two nodes."
        },
        "status": {"enum": ["proposed", "verified", "refuted"]},
        "origin": {
          "enum": ["objective", "research"],
          "description": "'objective' nodes are seeded from the canonical objective (principal, initial capabilities, goals) and are definitional rather than discovered."
        },
        "evidence_refs": {"$ref": "#/$defs/RefList"},
        "source_candidates": {"$ref": "#/$defs/RefList"},
        "source_edges": {"$ref": "#/$defs/RefList"},
        "confidence": {"enum": ["unknown", "low", "medium", "high"]},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      }
    },
    "Edge": {
      "type": "object",
      "required": ["id", "key", "from", "to", "relation", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^EDGE-[0-9]{3,}$"},
        "key": {"type": "string", "minLength": 1},
        "from": {"type": "string", "pattern": "^(PRIN|CAP|GOAL)-[0-9]{3,}$"},
        "to": {"type": "string", "pattern": "^(PRIN|CAP|GOAL)-[0-9]{3,}$"},
        "relation": {"enum": ["enables", "requires", "bypasses", "breaks_assumption", "escalates_to"]},
        "via_candidate": {
          "type": "string",
          "pattern": "^cand-[a-z0-9-]{3,}$",
          "description": "Identity field when present: the candidate that justifies this conversion. Carrying provenance on the edge is what keeps a finding from having to store a candidate list."
        },
        "status": {
          "enum": ["proposed", "verified", "blocked", "refuted"],
          "description": "A refuted edge never participates in a verified path."
        },
        "evidence_refs": {"$ref": "#/$defs/RefList"},
        "verification_refs": {"$ref": "#/$defs/RefList"},
        "confidence": {"enum": ["unknown", "low", "medium", "high"]},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      }
    }
  }
}
