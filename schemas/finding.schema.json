{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rinne666/mini-audit-skill/schemas/finding.schema.json",
  "title": "mini-audit finding",
  "description": "Canonical finding model. Required by Spec §11.",
  "type": "object",
  "required": [
    "id",
    "fingerprint",
    "verdict",
    "class",
    "title",
    "summary",
    "source_ref",
    "trace"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "pattern": "^F-[0-9]{3,}$"},
    "fingerprint": {
      "type": "string",
      "pattern": "^v1:[a-f0-9]{64}$",
      "description": "Stable SHA-256 of normalized fingerprint inputs (Spec §12)."
    },
    "verdict": {"enum": ["confirmed", "needs_validation", "rejected"]},
    "disposition_reason": {
      "enum": [
        "by_design",
        "equivalent_capability",
        "post_compromise",
        "invented_permission",
        "keyword_cvss",
        "hypothetical_chain",
        "default_state_confusion",
        "speculative_client_behavior",
        "fix_as_proof",
        "insufficient_evidence",
        "hardening_only",
        "duplicate",
        "out_of_scope"
      ],
      "description": "Required when verdict == 'rejected'."
    },
    "class": {
      "type": "string",
      "description": "Vulnerability class id, e.g. idor, ssrf, sqli, race_condition."
    },
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 10},
    "source_ref": {
      "type": "object",
      "required": ["commit", "tree_hash"],
      "properties": {
        "commit": {"type": "string"},
        "tree_hash": {"type": "string"},
        "symbol": {"type": "string"}
      }
    },
    "attacker": {
      "type": "object",
      "properties": {
        "identity": {"type": "string"},
        "existing_authority": {"type": "string"}
      }
    },
    "boundary": {
      "type": "object",
      "required": ["type", "security_invariant", "crossed"],
      "properties": {
        "type": {"type": "string"},
        "security_invariant": {"type": "string"},
        "before_capability": {"type": "string"},
        "after_capability": {"type": "string"},
        "crossed": {"type": "boolean"}
      }
    },
    "root_cause": {"type": "string"},
    "trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["entrypoint", "propagation", "sink", "validator", "auth_check"]},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 0},
          "symbol": {"type": "string"}
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "value"],
        "properties": {
          "kind": {"type": "string"},
          "value": {"type": "string"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {"type": "object"}
    },
    "execution": {
      "type": "object",
      "properties": {
        "status": {"enum": ["not_executed", "blocked", "needs_sandbox", "reproduced", "failed", "negative"]},
        "observed_result": {"type": "string"}
      }
    },
    "severity": {
      "type": "object",
      "properties": {
        "likelihood": {"enum": ["low", "medium", "high"]},
        "impact": {"enum": ["low", "medium", "high"]},
        "overall": {"enum": ["info", "low", "medium", "high", "critical"]},
        "reason": {"type": "string"},
        "provisional_severity": {"enum": ["info", "low", "medium", "high", "critical"]}
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "hunter_agent": {"type": "string"},
        "technical_verifier": {"type": "string"},
        "policy_judge": {"type": "string"},
        "cold_verifier": {"type": "string"},
        "independence": {"enum": ["same_session", "fresh_session_same_model", "cross_model", "cross_provider"]}
      }
    },
    "remediation": {
      "type": "object",
      "properties": {
        "strategy": {"type": "string"},
        "patch_hint": {"type": "string"}
      }
    },
    "default_security": {
      "type": "object",
      "properties": {
        "fresh_install_value": {"type": "string"},
        "security_sensitive": {"type": "boolean"},
        "admin_action_required": {"type": "boolean"},
        "deployment_override_detected": {"type": "boolean"}
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "rejected"}}},
      "then": {"required": ["disposition_reason"]}
    },
    {
      "if": {"properties": {"verdict": {"const": "confirmed"}}},
      "then": {
        "required": ["boundary", "severity", "verification"],
        "properties": {
          "verification": {"required": ["technical_verifier"]}
        }
      }
    }
  ]
}