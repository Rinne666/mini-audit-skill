{
  "id": "INCR-001",
  "name": "incremental audit reopens a blocked path after a coercion is removed",
  "description": "Two-commit incremental scenario: the v1 commit introduces A.py with both callers coercing their input, B.py with the SQL concatenation, and C.py with the privileged transition. The v2 commit edits A.py so ``run_import`` no longer coerces the filter, matching the chain-001 scenario. The eval replays the v1 commit through the same research-delta pipeline as long-horizon (so a blocked path is recorded), then runs `mini-audit-runtime diff scope --since <v1>` and `diff stage --stage D4 --symbol run_import` against the worktree to produce the diff artifacts, then submits a v2-style research delta that cites the diff as evidence for disproving the assumption. The metrics are: (a) Old Candidate Reuse Rate — cand-b-query is still kept by research state after the diff (it is not re-discovered); (b) Blocked Path Reopen Rate — the blocked path that blocked cand-b-query is reopened as a consequence of the assumption being disproved; (c) Affected Assumption Detection — the assumption 'every caller passes a list of integers' is recorded with status `disproved` and references the diff evidence; (d) Incremental Chain Completion — the same capability chain as long-horizon ends verified-reachable, and the closing delta carries diff-scope provenance.",
  "sources": ["A_v1.py", "A_v2.py", "B.py", "C.py"],
  "objective": {
    "principal": "unauthenticated_remote_user",
    "initial_capabilities": [
      "send_http_request"
    ],
    "target_capabilities": [
      "arbitrary_code_execution"
    ],
    "security_invariants": [
      "anonymous users cannot obtain privileged execution capability"
    ]
  },
  "candidates": [
    {
      "candidate_id": "cand-a-bypass",
      "status": "needs_validation"
    },
    {
      "candidate_id": "cand-b-query",
      "status": "needs_validation"
    },
    {
      "candidate_id": "cand-c-transition",
      "status": "needs_validation"
    }
  ],
  "commits": {
    "v1_message": "v1: import, validation, query, transition present; both callers coerce",
    "v2_message": "v2: remove run_import coercion (diff against v1)"
  },
  "steps": [
    {
      "note": "Pre-diff replay: build the v1 research state the same way long-horizon does, so a later step can ask 'does the diff invalidate any assumption in this state' rather than re-discover anything.",
      "delta": {
        "schema_version": 1,
        "agent_id": "agent-L5",
        "facts_add": [
          {
            "key": "fact:report-sql-concatenation",
            "claim": "B.py builds the report SQL by concatenating the author filter into the statement text",
            "evidence_refs": [
              "B.py:22"
            ],
            "confidence": "high"
          }
        ],
        "assumptions_add": [
          {
            "key": "assumption:callers-pass-int-list",
            "claim": "every caller reaching the report query passes a list of integers",
            "evidence_refs": [
              "A_v1.py:21",
              "A_v1.py:26"
            ]
          }
        ],
        "capabilities_add": [
          {
            "key": "cap:control-sql-expression",
            "name": "control_sql_expression",
            "status": "proposed",
            "source_candidates": [
              "cand-b-query"
            ],
            "evidence_refs": [
              "B.py:22"
            ]
          },
          {
            "key": "cap:control-scalar-parameter",
            "name": "control_scalar_parameter",
            "status": "proposed",
            "source_candidates": [
              "cand-a-bypass"
            ],
            "evidence_refs": [
              "A_v1.py:27"
            ]
          },
          {
            "key": "cap:privileged-state-transition",
            "name": "privileged_state_transition",
            "status": "proposed",
            "source_candidates": [
              "cand-c-transition"
            ],
            "evidence_refs": [
              "C.py:22"
            ]
          }
        ],
        "edges_add": [
          {
            "key": "edge:sql-requires-scalar",
            "from": "cap:control-sql-expression",
            "to": "cap:control-scalar-parameter",
            "relation": "requires",
            "status": "verified"
          },
          {
            "key": "edge:psm-enables-goal",
            "from": "cap:privileged-state-transition",
            "to": "GOAL-001",
            "relation": "enables",
            "status": "proposed"
          }
        ],
        "blocked_paths_add": [
          {
            "key": "blocked:query-needs-scalar",
            "candidate_id": "cand-b-query",
            "blocker": {
              "type": "input_validation",
              "claim": "the HTTP route and the import route coerce the author filter to a list of integers before the query",
              "assumption_ref": "assumption:callers-pass-int-list"
            },
            "priority": "high",
            "evidence_refs": [
              "A_v1.py:21",
              "A_v1.py:26"
            ],
            "reopen_if": [
              "a caller is found that reaches the query without coercing the filter"
            ]
          }
        ],
        "candidate_updates": [
          {
            "candidate_id": "cand-b-query",
            "research": {
              "local_validity": "verified",
              "role": "chain_seed",
              "chain_potential": "high",
              "requires_capabilities": [
                "control_scalar_parameter"
              ],
              "grants_capabilities": [
                "control_sql_expression"
              ],
              "depends_on_assumptions": [
                "assumption:callers-pass-int-list"
              ],
              "blocked_by": [
                "blocked:query-needs-scalar"
              ],
              "reopen_conditions": [
                "a caller reaches the query without coercing the filter"
              ]
            }
          },
          {
            "candidate_id": "cand-c-transition",
            "research": {
              "local_validity": "verified",
              "role": "prerequisite",
              "chain_potential": "high",
              "requires_capabilities": [
                "control_sql_expression"
              ],
              "grants_capabilities": [
                "privileged_state_transition"
              ]
            }
          }
        ]
      }
    },
    {
      "note": "Diff-triggered step: an incremental round reads the diff produced by `diff scope --since <v1>` and writes a delta that uses diff-scope provenance (the diff_evidence_ref field the diff-aware ledger carries) as the reason to disprove the assumption. The runtime must reopen the blocked path that depended on it and verify the previously `proposed` capabilities, completing the chain — all without the agent re-discovering cand-b-query from scratch.",
      "delta": {
        "schema_version": 1,
        "agent_id": "agent-L5b-diff",
        "facts_add": [
          {
            "key": "fact:diff-removed-coercion",
            "claim": "diff scope --since v1 shows run_import's coercion removed; the import path now reaches the query without coercing the filter",
            "evidence_refs": [
              "A.py:27"
            ],
            "diff_evidence_ref": "diff-scope.json:scope_type=since:baseline=v1:target=HEAD",
            "confidence": "high"
          }
        ],
        "assumptions_update": [
          {
            "ref": "assumption:callers-pass-int-list",
            "status": "disproved",
            "evidence_refs": [
              "A.py:27"
            ],
            "diff_evidence_ref": "diff-scope.json:scope_type=since:baseline=v1:target=HEAD"
          }
        ],
        "blocked_paths_reopen": [
          {
            "ref": "blocked:query-needs-scalar",
            "evidence_refs": [
              "A.py:27"
            ],
            "reopen_if": [
              "a caller reaches the query without coercing the filter"
            ]
          }
        ],
        "capabilities_update": [
          {
            "ref": "cap:control-scalar-parameter",
            "status": "verified",
            "evidence_refs": [
              "A.py:27"
            ]
          }
        ],
        "edges_add": [
          {
            "key": "edge:entry-to-scalar",
            "from": "objective:initial-capability:send_http_request",
            "to": "cap:control-scalar-parameter",
            "relation": "enables",
            "status": "verified",
            "via_candidate": "cand-a-bypass"
          }
        ],
        "candidate_updates": [
          {
            "candidate_id": "cand-a-bypass",
            "research": {
              "local_validity": "verified",
              "role": "prerequisite",
              "chain_potential": "high",
              "grants_capabilities": [
                "control_scalar_parameter"
              ],
              "breaks_assumptions": [
                "assumption:callers-pass-int-list"
              ]
            }
          }
        ]
      }
    },
    {
      "note": "Closure: with the parameter controllable and the concatenation drivable, the privileged transition is the last hop. This is the same step long-horizon uses; in the incremental scenario it carries diff-scope provenance via `diff_evidence_ref`.",
      "delta": {
        "schema_version": 1,
        "agent_id": "agent-L6c",
        "capabilities_update": [
          {
            "ref": "cap:control-sql-expression",
            "status": "verified",
            "evidence_refs": [
              "B.py:22"
            ]
          },
          {
            "ref": "cap:privileged-state-transition",
            "status": "verified",
            "evidence_refs": [
              "C.py:22"
            ]
          }
        ],
        "edges_add": [
          {
            "key": "edge:sql-enables-psm",
            "from": "cap:control-sql-expression",
            "to": "cap:privileged-state-transition",
            "relation": "enables",
            "status": "verified",
            "via_candidate": "cand-c-transition"
          }
        ],
        "edges_update": [
          {
            "ref": "edge:psm-enables-goal",
            "status": "verified"
          }
        ]
      }
    }
  ],
  "oracle": {
    "retain": [
      "cand-a-bypass",
      "cand-b-query",
      "cand-c-transition"
    ],
    "should_reopen": [
      "BP-001"
    ],
    "chains": [
