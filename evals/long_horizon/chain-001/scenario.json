  "objective": {
    "principal": "unauthenticated_remote_user",
    "initial_capabilities": [
      "send_http_request"
    ],
    "target_capabilities": [
      "arbitrary_code_execution"
    ],
    "security_invariants": [
      "anonymous users cannot obtain privileged execution capability"
    ]
  },
